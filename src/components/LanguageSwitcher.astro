---
import { locales, localeLabels, localeNames, type Locale } from '../i18n/types';
import { switchLocalePath } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  currentLocale: Locale;
}
const { currentLocale } = Astro.props;
const path = Astro.url.pathname;
---
<div class="lang" data-lang>
  <button type="button" class="lang-btn" aria-haspopup="listbox" aria-expanded="false" data-lang-toggle>
    <span aria-hidden="true">{localeLabels[currentLocale]}</span>
    <Icon name="chevron-down" size={14} strokeWidth={2} />
    <span class="sr-only">Language</span>
  </button>
  <ul class="lang-menu" role="listbox" data-lang-menu hidden>
    {locales.map((loc) => (
      <li>
        <a
          href={switchLocalePath(path, loc, currentLocale)}
          hreflang={loc}
          class={loc === currentLocale ? 'is-active' : ''}
          role="option"
          aria-selected={loc === currentLocale}
        >
          <strong>{localeLabels[loc]}</strong>
          <span>{localeNames[loc]}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang { position: relative; }
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-navy-900);
    background: transparent;
    border: 1px solid var(--color-line-300);
    border-radius: var(--radius-tight);
    cursor: pointer;
    transition: border-color .18s ease, color .18s ease;
  }
  .lang-btn:hover { border-color: var(--color-navy-900); }
  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 160px;
    background: var(--color-white);
    border: 1px solid var(--color-line-300);
    box-shadow: var(--shadow-cardHover);
    padding: 0.25rem;
    list-style: none;
    margin: 0;
    z-index: 60;
  }
  .lang-menu[hidden] { display: none; }
  .lang-menu a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink-700);
    text-decoration: none;
    transition: background-color .15s ease, color .15s ease;
  }
  .lang-menu a strong {
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-navy-900);
    min-width: 24px;
  }
  .lang-menu a span { color: var(--color-ink-500); }
  .lang-menu a:hover { background: var(--color-surface-50); color: var(--color-navy-900); }
  .lang-menu a.is-active {
    background: var(--color-sky-50);
    color: var(--color-navy-900);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
