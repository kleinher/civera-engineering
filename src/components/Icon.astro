---
type IconName =
  | 'concrete'
  | 'steel'
  | 'foundation'
  | 'connections'
  | 'documentation'
  | 'rc-calc'
  | 'industrial'
  | 'steel-conn'
  | 'international'
  | 'review'
  | 'globe'
  | 'users'
  | 'shield'
  | 'requirements'
  | 'analysis'
  | 'design'
  | 'delivery'
  | 'arrow-right'
  | 'arrow-left'
  | 'menu'
  | 'close'
  | 'check'
  | 'mail'
  | 'linkedin'
  | 'map-pin'
  | 'upload'
  | 'chevron-down';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  strokeWidth?: number;
  ariaLabel?: string;
}

const { name, size = 24, class: className = '', strokeWidth = 1.5, ariaLabel } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': strokeWidth,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  class: className,
  ...(ariaLabel ? { role: 'img', 'aria-label': ariaLabel } : { 'aria-hidden': 'true' }),
};
---
