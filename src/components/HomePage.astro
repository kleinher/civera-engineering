---
import type { Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './sections/Hero.astro';
import Services from './sections/Services.astro';
import Projects from './sections/Projects.astro';
import Experience from './sections/Experience.astro';
import Visualisation from './sections/Visualisation.astro';
import Process from './sections/Process.astro';
import About from './sections/About.astro';
import Contact from './sections/Contact.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<BaseLayout locale={locale}>
  <Hero locale={locale} />
  <Services locale={locale} />
  <Projects locale={locale} />
  <Experience locale={locale} />
  <Visualisation locale={locale} />
  <Process locale={locale} />
  <About locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
