---
import type { Locale } from '../../i18n/types';
import { useTranslations } from '../../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<!--
  Final hero image: assets/images/hero/civera-hero.jpg
  Recommended composition:
   - reinforced-concrete residential building at left/centre;
   - industrial steel structure at right;
   - professional architectural photography, no construction workers or generic stock imagery.
-->
<section class="hero" aria-label="Introduction">
  <div class="hero-media" aria-hidden="true">
    <div class="hero-placeholder"></div>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container-page hero-inner">
    <div class="hero-content reveal">
      <h1>
        <span>{t.hero.line1}</span>
        <span>{t.hero.line2}</span>
        <span>{t.hero.line3}</span>
      </h1>
      <p class="lead">{t.hero.supporting}</p>
      <p class="categories">{t.hero.categories}</p>
      <div class="actions">
        <a href="#services" class="btn btn-primary">{t.hero.primary}</a>
        <a href="#contact" class="btn btn-secondary">{t.hero.secondary}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: var(--color-navy-900);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--hero-image, none);
    background-size: cover;
    background-position: center right;
  }
  .hero-placeholder {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.03) 25%, transparent 25%, transparent 50%, rgba(255,255,255,0.03) 50%, rgba(255,255,255,0.03) 75%, transparent 75%, transparent),
      linear-gradient(180deg, #12315c, #071b33 70%);
    background-size: 32px 32px, auto;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(5,18,41,0.98) 0%,
      rgba(5,18,41,0.92) 32%,
      rgba(5,18,41,0.55) 55%,
      rgba(5,18,41,0.15) 75%,
      rgba(5,18,41,0) 100%
    );
    z-index: 1;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    padding-block: 4rem;
  }
  .hero-content {
    max-width: 620px;
    color: var(--color-white);
  }
  h1 {
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
  }
  h1 span { display: block; }
  .lead {
    margin-top: 1.25rem;
    max-width: 46ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.86);
  }
  .categories {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    letter-spacing: var(--tracking-widest);
    font-weight: 600;
    color: rgb(255 255 255 / 0.72);
    text-transform: uppercase;
  }
  .actions {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  @media (max-width: 40rem) {
    .actions .btn { flex: 1 1 auto; }
  }
  @media (min-width: 60rem) {
    .hero { min-height: 620px; }
    .hero-inner { padding-block: 5rem; }
  }
  @media (min-width: 80rem) {
    .hero { min-height: 680px; }
  }
</style>
