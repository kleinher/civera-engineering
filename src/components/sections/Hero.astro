---
import type { Locale } from '../../i18n/types';
import { useTranslations } from '../../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="hero" aria-label="Introduction">
  <div class="hero-media" aria-hidden="true">
    <svg class="hero-grid" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" role="presentation">
      <defs>
        <pattern id="dot-grid" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" fill="rgba(255,255,255,0.08)" />
        </pattern>
        <linearGradient id="line-fade" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="rgba(255,255,255,0)" />
          <stop offset="0.35" stop-color="rgba(255,255,255,0.12)" />
          <stop offset="1" stop-color="rgba(255,255,255,0)" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#dot-grid)" />
      <g stroke="url(#line-fade)" stroke-width="1">
        <line x1="0" y1="220" x2="1600" y2="220" />
        <line x1="0" y1="450" x2="1600" y2="450" />
        <line x1="0" y1="680" x2="1600" y2="680" />
      </g>
      <g stroke="rgba(184,153,104,0.35)" stroke-width="1">
        <line x1="1080" y1="120" x2="1080" y2="820" />
      </g>
      <g stroke="rgba(255,255,255,0.14)" stroke-dasharray="4 6" stroke-width="1">
        <line x1="1240" y1="120" x2="1240" y2="820" />
        <line x1="1400" y1="120" x2="1400" y2="820" />
      </g>
    </svg>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container-page hero-inner">
    <div class="hero-content reveal">
      <span class="hero-accent" aria-hidden="true"></span>
      <h1>
        <span>{t.hero.line1}</span>
        <span>{t.hero.line2}</span>
        <span>{t.hero.line3}</span>
      </h1>
      <p class="lead">{t.hero.supporting}</p>
      <p class="categories">{t.hero.categories}</p>
      <div class="actions">
        <a href="#services" class="btn btn-primary">{t.hero.primary}</a>
        <a href="#projects" class="btn btn-secondary">{t.hero.secondary}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: linear-gradient(180deg, #0a2247 0%, #051229 100%);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(5,18,41,0.90) 0%,
      rgba(5,18,41,0.72) 42%,
      rgba(5,18,41,0.35) 75%,
      rgba(5,18,41,0.2) 100%
    );
    z-index: 1;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    padding-block: 4rem;
  }
  .hero-content {
    max-width: 640px;
    color: var(--color-white);
    position: relative;
  }
  .hero-accent {
    display: block;
    width: 36px;
    height: 2px;
    background: var(--color-brass-500);
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
  }
  h1 span { display: block; }
  .lead {
    margin-top: 1.25rem;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.86);
  }
  .categories {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    letter-spacing: var(--tracking-widest);
    font-weight: 600;
    color: rgb(255 255 255 / 0.72);
    text-transform: uppercase;
  }
  .actions {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  @media (max-width: 40rem) {
    .actions .btn { flex: 1 1 auto; }
  }
  @media (min-width: 60rem) {
    .hero { min-height: 620px; }
    .hero-inner { padding-block: 5rem; }
  }
  @media (min-width: 80rem) {
    .hero { min-height: 680px; }
  }
</style>
