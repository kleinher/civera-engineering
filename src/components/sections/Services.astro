---
import type { Locale } from '../../i18n/types';
import { useTranslations } from '../../i18n';
import Icon from '../Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);

const items = [
  { key: 'concrete', icon: 'concrete' as const },
  { key: 'steel', icon: 'steel' as const },
  { key: 'foundation', icon: 'foundation' as const },
  { key: 'connections', icon: 'connections' as const },
  { key: 'documentation', icon: 'documentation' as const },
  { key: 'industrial', icon: 'industrial' as const },
] as const;
---
<section id="services" class="services">
  <div class="container-page">
    <h2 class="section-title">{t.services.title}</h2>
    <div class="grid reveal">
      {items.map((it) => (
        <article class="service">
          <div class="icon" aria-hidden="true">
            <Icon name={it.icon} size={52} strokeWidth={1.2} />
          </div>
          <h3>{t.services.items[it.key].title}</h3>
          <p>{t.services.items[it.key].desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 5rem 0 4rem;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-line-200);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 0;
  }
  .service {
    padding: 1.25rem 1.5rem;
    text-align: center;
    transition: background-color .2s ease;
    position: relative;
  }
  .icon {
    color: var(--color-navy-900);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    height: 60px;
    margin-bottom: 1.25rem;
    transition: color .2s ease, transform .2s ease;
  }
  .service:hover .icon { color: var(--color-accent-500); transform: translateY(-2px); }
  .service h3 {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-navy-900);
    margin: 0 0 0.625rem;
    line-height: 1.4;
  }
  .service p {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-ink-500);
    max-width: 32ch;
    margin: 0 auto;
  }
  @media (min-width: 40rem) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: 2.25rem 1rem; }
  }
  @media (min-width: 60rem) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: 2.5rem 0; }
    .service { border-left: 1px solid var(--color-line-200); }
    .service:nth-child(3n+1) { border-left: 0; }
  }
</style>
