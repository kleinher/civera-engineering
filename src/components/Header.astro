---
import type { Locale } from '../i18n/types';
import { useTranslations, localisePath } from '../i18n';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  /** Whether nav anchors point back to the home page (needed on project sub-pages). */
  homeBase?: string;
}
const { locale, homeBase } = Astro.props;
const t = useTranslations(locale);
const home = localisePath('/', locale);
const anchor = (id: string) => (homeBase ? `${homeBase}#${id}` : `#${id}`);

const links = [
  { key: 'home', href: home, isAnchor: false },
  { key: 'services', href: anchor('services'), isAnchor: true },
  { key: 'projects', href: anchor('projects'), isAnchor: true },
  { key: 'experience', href: anchor('experience'), isAnchor: true },
  { key: 'visualisation', href: anchor('visualisation'), isAnchor: true },
  { key: 'about', href: anchor('about'), isAnchor: true },
  { key: 'contact', href: anchor('contact'), isAnchor: true },
] as const;
---
<header class="site-header" data-header>
  <div class="container-page bar">
    <Logo href={home} />

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav-link
              data-nav-target={l.isAnchor ? l.href.split('#')[1] : undefined}
            >
              {t.nav[l.key]}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <LanguageSwitcher currentLocale={locale} />
      <a class="btn btn-nav hide-md" href={anchor('contact')}>{t.nav.cta}</a>
      <button
        type="button"
        class="hamburger"
        aria-label={t.nav.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="nav-mobile" data-mobile-menu hidden>
    <div class="container-page nav-mobile-inner">
      <button type="button" class="close" aria-label={t.nav.close} data-menu-close>
        <Icon name="close" size={22} />
      </button>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} data-nav-link data-mobile-link>{t.nav[l.key]}</a>
          </li>
        ))}
      </ul>
      <a class="btn btn-primary w-full" href={anchor('contact')} data-mobile-link>{t.nav.cta}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-line-200);
    transition: box-shadow .2s ease;
  }
  .site-header[data-scrolled="true"] {
    box-shadow: 0 1px 4px rgb(16 24 40 / 0.06);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 72px;
  }
  .nav-desktop { display: none; }
  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop a {
    position: relative;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink-700);
    text-decoration: none;
    padding: 0.5rem 0;
    transition: color .18s ease;
  }
  .nav-desktop a:hover,
  .nav-desktop a[aria-current="true"] {
    color: var(--color-navy-900);
  }
  .nav-desktop a[aria-current="true"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent-500);
  }
  .nav-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line-300);
    background: transparent;
    color: var(--color-navy-900);
    cursor: pointer;
    border-radius: var(--radius-tight);
  }
  .hide-md { display: none; }

  .nav-mobile {
    position: fixed;
    inset: 0;
    top: 72px;
    background: var(--color-white);
    z-index: 55;
    padding: 1.5rem 0 2rem;
    overflow-y: auto;
    animation: slideDown .22s ease;
  }
  .nav-mobile[hidden] { display: none; }
  .nav-mobile-inner { display: flex; flex-direction: column; gap: 1.25rem; }
  .nav-mobile .close {
    align-self: flex-end;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line-300);
    background: transparent;
    color: var(--color-navy-900);
    cursor: pointer;
    border-radius: var(--radius-tight);
  }
  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nav-mobile a {
    display: block;
    padding: 0.75rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-navy-900);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line-200);
  }
  .w-full { width: 100%; padding-block: 0.875rem; margin-top: 0.5rem; }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-mobile { animation: none; }
  }

  @media (min-width: 60rem) {
    .bar { min-height: 76px; }
    .nav-desktop { display: block; }
    .hamburger { display: none; }
    .hide-md { display: inline-flex; }
    .nav-mobile { display: none !important; }
  }

  @media (min-width: 80rem) {
    .nav-desktop ul { gap: 2.25rem; }
  }
</style>
