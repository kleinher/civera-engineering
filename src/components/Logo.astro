---
interface Props {
  variant?: 'dark' | 'light';
  href?: string;
}
const { variant = 'dark', href = '/' } = Astro.props;
const primary = variant === 'dark' ? 'var(--color-navy-900)' : 'var(--color-white)';
const secondary = variant === 'dark' ? 'var(--color-mute-500)' : 'rgb(255 255 255 / 0.75)';
---
<!-- Insert final SVG logo here: replace this text-based mark with civera-logo.svg / civera-logo-white.svg -->
<a href={href} class="logo" aria-label="Civera Engineering — Home">
  <span class="logo-mark" aria-hidden="true">
    <svg viewBox="0 0 40 40" width="34" height="34" fill="none" stroke={primary} stroke-width="1.6" stroke-linecap="square">
      <rect x="4" y="4" width="32" height="32" />
      <line x1="4" y1="20" x2="36" y2="20" />
      <line x1="20" y1="4" x2="20" y2="36" />
      <line x1="4" y1="4" x2="36" y2="36" stroke={secondary} stroke-dasharray="2 3" />
    </svg>
  </span>
  <span class="logo-text">
    <span class="logo-name" style={`color:${primary};`}>CIVERA</span>
    <span class="logo-sub" style={`color:${secondary};`}>ENGINEERING</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    line-height: 1;
  }
  .logo-mark { display: inline-flex; }
  .logo-text {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
  }
  .logo-name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .logo-sub {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.32em;
  }
</style>
